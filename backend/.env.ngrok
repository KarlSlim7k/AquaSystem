# ===============================================
# Configuración ngrok (Temporal - Desarrollo)
# ===============================================
# IMPORTANTE: Este archivo NO se commitea a Git
# Las URLs de ngrok deben actualizarse cada vez que inicies ngrok
# ===============================================

APP_NAME=AquaTenex
APP_ENV=production
APP_KEY=base64:VQx8jZ9K2wP5mN3qR7tY0uI1oP8aS4dF6gH9jK2lM5n=
APP_DEBUG=false

# ⚠️ ACTUALIZAR ESTAS URLs CADA VEZ QUE INICIES NGROK
APP_URL=https://tu-backend.ngrok-free.app
FRONTEND_URL=https://tu-frontend.ngrok-free.app

# Base de datos (mantener local o usar remota)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquatenex_db
DB_USERNAME=root
DB_PASSWORD=

# CORS y Sanctum (actualizar con tu URL de frontend de ngrok)
SANCTUM_STATEFUL_DOMAINS=tu-frontend.ngrok-free.app
SESSION_DOMAIN=.ngrok-free.app
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Cache y Queue
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Mail (opcional)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===============================================
# INSTRUCCIONES DE USO:
# ===============================================
# 1. Ejecuta: ngrok http 8000 (para backend)
# 2. Ejecuta: ngrok http 5173 (para frontend)
# 3. Copia las URLs generadas por ngrok
# 4. Actualiza APP_URL, FRONTEND_URL y SANCTUM_STATEFUL_DOMAINS
# 5. Guarda este archivo
# 6. Ejecuta: server_manager\apply_ngrok_config.bat
# 7. Inicia los servidores normalmente
# ===============================================
