# ===============================================
# Configuración ngrok para Frontend (Temporal)
# ===============================================
# IMPORTANTE: Actualizar la URL cada vez que inicies ngrok
# ===============================================

# ⚠️ ACTUALIZAR ESTA URL CON LA URL DE NGROK DE TU BACKEND
VITE_API_URL=https://tu-backend.ngrok-free.app/api

# ===============================================
# INSTRUCCIONES DE USO:
# ===============================================
# 1. Inicia ngrok para el backend: ngrok http 8000
# 2. Copia la URL que genera ngrok (ej: https://abc123.ngrok-free.app)
# 3. Actualiza VITE_API_URL agregando "/api" al final
# 4. Guarda este archivo
# 5. Ejecuta: server_manager\apply_ngrok_config.bat
# 6. Rebuild del frontend si es necesario
# ===============================================
